# Application
APP_ENVIRONMENT=development
APP_NAME=Vyntics API
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Database (Supabase Session Pooler; use the real values only in untracked .env)
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase (connections are deferred until later phases)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Authentication / security (enforcement is deferred until Phase 12)
AUTH_ALLOWED_EMAIL_DOMAIN=vyntics.com

# Storage (bucket configuration is deferred until Phase 13)
STORAGE_PROVIDER=supabase

# External integrations (integration is deferred)
RESEND_API_KEY=
SENTRY_DSN=
