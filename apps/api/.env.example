# Application
APP_ENVIRONMENT=development
APP_NAME=Vyntics API
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Database (Supabase Session Pooler; use the real values only in untracked .env)
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase (server-side Auth verification and privileged Storage access)
SUPABASE_URL=
# Public/anon project key used server-side for /auth/v1/user verification
SUPABASE_ANON_KEY=
# Privileged server-only key; never use for user-token verification or clients
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Authentication / security
AUTH_ALLOWED_EMAIL_DOMAIN=vyntics.com

# Storage (all bucket mutations are backend-managed)
STORAGE_PROVIDER=supabase
STORAGE_BLOG_COVERS_BUCKET=blog-covers
STORAGE_CASE_STUDY_COVERS_BUCKET=case-study-covers
STORAGE_TEAM_PHOTOS_BUCKET=team-photos
STORAGE_JOB_RESUMES_BUCKET=job-applications
STORAGE_IMAGE_MAX_BYTES=5242880
STORAGE_RESUME_SIGNED_URL_TTL_SECONDS=300
STORAGE_RESUME_MAX_BYTES=10485760

# External integrations (integration is deferred)
RESEND_API_KEY=
SENTRY_DSN=
