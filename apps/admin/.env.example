# Browser-safe Supabase project URL used by Phase B authentication.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Browser-safe Supabase anon or publishable key. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# FastAPI origin with no trailing slash and no implicit /api prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
