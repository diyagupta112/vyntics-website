# Public website origin used by metadata, sitemap.xml, and robots.txt.
# Leave unset to use the production fallback defined in src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# Public content API, shared with the existing content readers.
API_BASE_URL=http://127.0.0.1:8000

# Server-only secret for POST /api/revalidate-sitemap (Authorization: Bearer <secret>).
SITEMAP_REVALIDATION_SECRET=
