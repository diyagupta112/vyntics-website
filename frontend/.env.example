# Public website origin used by metadata, sitemap.xml, and robots.txt.
# Leave unset to use the production fallback defined in src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=

# Public content API, shared with the existing content readers.
API_BASE_URL=http://127.0.0.1:8000

# Server-only secret for POST /api/revalidate-sitemap (Authorization: Bearer <secret>).
SITEMAP_REVALIDATION_SECRET=

# Server-only key for the chatbot AI replies (POST /api/chat). Never expose it to the browser.
# Set GROQ_API_KEY or ANTHROPIC_API_KEY (Groq is used first if both are set).
# Leave both unset to use the built-in keyword matching. CHATBOT_MODEL is optional.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
