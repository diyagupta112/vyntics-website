{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@vyntics/ui/*": ["packages/ui/src/*"],
      "@vyntics/config/*": ["packages/config/src/*"],
      "@vyntics/database/*": ["packages/database/src/*"],
      "@vyntics/types/*": ["packages/types/src/*"],
      "@vyntics/utils/*": ["packages/utils/src/*"]
    }
  }
}
